{
  "name": "mengfei-li-academic-site",
  "version": "1.0.0",
  "description": "Build and quality tooling for Mengfei Li's academic website",
  "repository": {
    "type": "git",
    "url": "https://github.com/MurphyLiCN/MengfeiLi.github.io"
  },
  "keywords": ["jekyll", "academic-website", "github-pages"],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/MurphyLiCN/MengfeiLi.github.io/issues"
  },
  "homepage": "https://murphylicn.github.io/MengfeiLi.github.io/",
  "engines": {
    "node": "24.18.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.61.1",
    "lighthouse": "^13.4.1",
    "onchange": "^7.1.0",
    "uglify-js": "^3.17.4"
  },
  "scripts": {
    "uglify": "uglifyjs assets/js/plugins/jquery.greedy-navigation.js assets/js/_main.js -c -m -o assets/js/main.min.js",
    "watch:js": "onchange \"assets/js/**/*.js\" -e \"assets/js/main.min.js\" -- npm run build:js",
    "build:js": "npm run uglify",
    "check:content": "ruby scripts/check_content.rb",
    "check:build": "python3 scripts/check_built_site.py _site",
    "test:e2e": "playwright test",
    "test": "npm run check:content && npm run test:e2e",
    "serve:static": "node scripts/serve_static.mjs _site",
    "lighthouse": "node scripts/run_lighthouse.mjs"
  }
}
